{
    "name": "playground",
    "version": "1.0.0",
    "license": "Apache-2.0",
    "homepage": "https://play.allurx.io/",
    "private": true,
    "type": "module",
    "description": "allurx 的交互作品与浏览器实验。",
    "workspaces": [
        "projects/*"
    ],
    "engines": {
        "node": "24.21.0"
    },
    "scripts": {
        "dev": "npm run build && vite preview",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint . --max-warnings 0",
        "check:syntax": "node --check scripts/build.mjs && npm run check:syntax --workspaces --if-present",
        "type-check": "tsc -b --noEmit",
        "check": "npm run format:check && npm run lint && npm run check:syntax && npm run type-check",
        "build": "npm run build --workspaces --if-present && node scripts/build.mjs",
        "verify": "npm run check && npm run build",
        "preview": "wrangler dev --port 4175",
        "deploy": "wrangler deploy"
    },
    "devDependencies": {
        "@allurx/js-config": "1.1.0",
        "@types/node": "24.19.2",
        "eslint": "10.12.0",
        "jiti": "2.7.0",
        "prettier": "3.9.10",
        "typescript": "6.0.3",
        "vite": "8.3.4",
        "wrangler": "4.151.1"
    },
    "prettier": "@allurx/js-config/prettier"
}
