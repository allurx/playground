{
    "name": "playground",
    "version": "1.0.0",
    "license": "Apache-2.0",
    "homepage": "https://play.allurx.io/",
    "private": true,
    "type": "module",
    "description": "allurx 的交互作品与浏览器实验。",
    "workspaces": [
        "projects/*"
    ],
    "engines": {
        "node": "24.21.0"
    },
    "scripts": {
        "dev": "npm run build:web && vite preview",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint . --max-warnings 0",
        "type-check": "tsc -b --noEmit && npm run type-check --workspaces",
        "check": "npm run format:check && npm run lint && npm run type-check",
        "build": "npm run build:web && npm run build:portable",
        "build:web": "npm run build --workspaces && node scripts/build.ts web",
        "build:portable": "npm run build:portable --workspaces && node scripts/build.ts portable",
        "package:release": "node scripts/package-release.ts",
        "verify": "npm run check && npm run build",
        "preview": "wrangler dev --port 4175",
        "deploy": "wrangler deploy"
    },
    "devDependencies": {
        "@allurx/js-config": "1.1.0",
        "@types/node": "24.19.2",
        "eslint": "10.12.0",
        "jiti": "2.7.0",
        "prettier": "3.9.10",
        "typescript": "6.0.3",
        "vite": "8.3.4",
        "vite-plugin-singlefile": "2.3.4",
        "wrangler": "4.151.1"
    },
    "prettier": "@allurx/js-config/prettier"
}
